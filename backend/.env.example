# 后端环境变量示例（复制为 .env 使用；不要把真实密码提交到仓库）
# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recipe_menu
DB_USERNAME=root
DB_PASSWORD=FengXue@

# Redis（可选，不启动也能用，仅健康检查显示 DOWN）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Flyway 自动建表（默认 true）
FLYWAY_ENABLED=true

# 敏感配置：主密钥文件路径（默认 data/secret.key，首次启动自动生成）
# AI_KEY_MASTER_FILE=data/secret.key
# JWT_SECRET_FILE=data/jwt.secret
# AI_KEY_MASTER=Base64编码的32字节密钥（可选，优先于文件）

# AI 配图等本地上传目录
UPLOAD_DIR=data/uploads

# 每日视频收藏扫描 Cron（默认每天 06:00，Asia/Shanghai）
# INTEGRATION_SCAN_CRON=0 0 6 * * *

# 前端跨域来源（开发时通常走 Vite 代理，可留空）
# CORS_ORIGINS=http://localhost:5173
